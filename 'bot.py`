# Ye function button banayega
def gen_markup():
    markup = InlineKeyboardMarkup()
    markup.row_width = 1
    # Apne bot ka username yahan 'Mention_1bot' ki jagah dalna
    markup.add(InlineKeyboardButton("Add me to your group", url="http://t.me/Mention_1bot?startgroup=true"))
    return markup

@bot.message_handler(commands=['start'])
def send_welcome(message):
    # Jab koi /start karega toh button ke saath reply jayega
    bot.reply_to(message, "Hello! Main active hoon. Mujhe apne group mein add karne ke liye niche button pe click karein:", reply_markup=gen_markup())

